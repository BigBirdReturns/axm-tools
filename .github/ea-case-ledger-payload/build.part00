from __future__ import annotations

import base64
import gzip
import json
import re
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path.cwd()
HTML = ROOT / "essential-attention/index.html"
PAYLOAD = ROOT / ".github/ea-case-ledger-payload"

MAP = [
    "....W.....W.....",
    "................",
    "..W....W.....WW.",
    ".W..WW.WW..W..W.",
    "..WWWWWWWW..W...",
    ".WWWWWWWWWW.....",
    "..WWWWWWWWW.....",
    "..WWWWWWWW......",
    "...WWWWWW.o.....",
    ".....WWW........",
    "......o.......W.",
    "......o.........",
    "...o..o..o......",
    "..o...o..o......",
    "......o.........",
    ".....oo.........",
    ".....oo.........",
    "...oooooo.......",
]


def bundle_parts(path: Path) -> tuple[dict, str]:
    text = path.read_text(encoding="utf-8")
    manifest_match = re.search(
        r'<script type="__bundler/manifest">\s*(.*?)\s*</script>', text, re.S
    )
    template_match = re.search(
        r'<script type="__bundler/template">\s*(.*?)\s*</script>', text, re.S
    )
    if not manifest_match or not template_match:
        raise RuntimeError(f"Bundled identity donor is malformed: {path}")
    return json.loads(manifest_match.group(1)), json.loads(template_match.group(1))


def latin_font(path: Path, family: str, weight: int, style: str = "normal") -> str:
    manifest, template = bundle_parts(path)
    for block in re.findall(r"@font-face\s*\{(.*?)\}", template, re.S):
        if (
            f"font-family: '{family}'" not in block
            or f"font-weight: {weight}" not in block
            or f"font-style: {style}" not in block
            or "U+0000-00FF" not in block
        ):
            continue
        source = re.search(r'src:\s*url\("([^"]+)"\)', block)
        if not source:
            continue
        entry = manifest[source.group(1)]
        data = base64.b64decode(entry["data"])
        if entry.get("compressed"):
            data = gzip.decompress(data)
        return base64.b64encode(data).decode("ascii")
    raise RuntimeError(f"Latin font subset missing: {family} {weight} {style}")


def mark_svg(label: str, title: str = "AXM pixel dandelion") -> str:
    rects: list[str] = []
    for y, row in enumerate(MAP):
        for x, char in enumerate(row):
            if char == ".":
                continue
            fill = "#ECE7D8" if char == "W" else "#7C7F57"
            rects.append(f'<rect x="{x}" y="{y}" width="1" height="1" fill="{fill}"/>')
    return (
        f'<svg class="{label}" viewBox="0 0 16 18" role="img" aria-label="{title}" '
        'xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">'
        f'<title>{title}</title>{"".join(rects)}</svg>'
    )


source = HTML.read_text(encoding="utf-8")
if "Essential Attention v1.0.3" not in source:
    raise SystemExit("Expected the qualified v1.0.3 donor")

css_parts = sorted(PAYLOAD.glob("css.part*"))
if not css_parts:
    raise SystemExit("Case Ledger CSS payload is missing")
css = "".join(part.read_text(encoding="utf-8") for part in css_parts)

house = ROOT / "identity/axm/house-style/AXM-House-Style-v1.2.standalone.html"
scg = ROOT / "identity/scg/releases/SCG-Identity-v3.1/SCG-Identity-System-v3.standalone.html"
fonts = {
    "barlow700": latin_font(house, "Barlow Condensed", 700),
    "plexmono400": latin_font(house, "IBM Plex Mono", 400),
    "plexmono600": latin_font(house, "IBM Plex Mono", 600),
    "lora400": latin_font(house, "Lora", 400),
    "plexsans400": latin_font(scg, "IBM Plex Sans", 400),
}
font_css = f'''@font-face{{font-family:"Barlow Condensed";font-style:normal;font-weight:700 900;font-display:swap;src:url(data:font/woff2;base64,{fonts["barlow700"]}) format("woff2")}}
@font-face{{font-family:"IBM Plex Mono";font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,{fonts["plexmono400"]}) format("woff2")}}
@font-face{{font-family:"IBM Plex Mono";font-style:normal;font-weight:600 700;font-display:swap;src:url(data:font/woff2;base64,{fonts["plexmono600"]}) format("woff2")}}
@font-face{{font-family:"IBM Plex Sans";font-style:normal;font-weight:400 700;font-display:swap;src:url(data:font/woff2;base64,{fonts["plexsans400"]}) format("woff2")}}
@font-face{{font-family:"Lora";font-style:normal;font-weight:400 700;font-display:swap;src:url(data:font/woff2;base64,{fonts["lora400"]}) format("woff2")}}
'''
css = font_css + css
css = css.replace(
    '--display:"Arial Narrow","Roboto Condensed","Franklin Gothic Condensed","Haettenschweiler",Impact,sans-serif;',
    '--display:"Barlow Condensed","Arial Narrow","Roboto Condensed",sans-serif;',
)
css = css.replace(
    '--serif:Georgia,"Times New Roman",serif;',
    '--serif:"Lora",Georgia,"Times New Roman",serif;',
)
css = css.replace(
    '--sans:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;',
    '--sans:"IBM Plex Sans",Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;',
)

start = source.index("<style>") + len("<style>")
end = source.index("</style>", start)
source = source[:start] + "\n" + css + "\n" + source[end:]
source = source.replace('font-src \'none\'', "font-src data:")
source = source.replace('<meta name="color-scheme" content="light">', '<meta name="color-scheme" content="dark light">')
source = source.replace(
    '<title>Essential Attention v1.0.3 · FAB Runtime</title>',
    '<title>Essential Attention v1.0.4 · FAB Case Ledger</title>',
)
source = source.replace(
    '<meta name="robots" content="noindex,nofollow,noarchive">',
    '<meta name="robots" content="noindex,nofollow,noarchive">\n<meta name="description" content="A source-bound FAB aftermath case ledger with contained internal roles, local evidence custody, and explicit external-effect limits.">',
)
source = source.replace("Essential Attention v1.0.3", "Essential Attention v1.0.4")
source = source.replace("version:'1.0.3'", "version:'1.0.4'")
source = re.sub(
    r"built_at:'[^']+'",
    f"built_at:'{datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace('+00:00','Z')}'",
    source,
    count=1,
)

rail_mark = mark_svg("pixel-dandelion rail-mark")
hero_mark = mark_svg("pixel-dandelion hero-mark")
old_brand = '<div class="brand"><div class="mark">EA</div><div><strong>Essential Attention</strong><small>v1.0.3 · FAB loaded</small></div></div>'
new_brand = f'''<div class="brand"><div class="mark">{rail_mark}</div><div><strong>Essential<br>Attention</strong><small>v1.0.4 · FAB / CASE 001</small></div></div>'''
if old_brand not in source:
    raise SystemExit("Brand seam missing")
source = source.replace(old_brand, new_brand, 1)
source = source.replace(
    '<div class="rail-footer">Default cartridge<br><code>mw-ea-n0-fab-offers-001</code><br><br>Public-safe summaries are embedded. Private source bytes never leave this browser.</div>',
    '<div class="rail-footer">CASE CARTRIDGE<br><code>mw-ea-n0-fab-offers-001</code><br><br>AXM DARK ECOSYSTEM SHELL<br>HOUSE STYLE EDITORIAL FIELD<br><br>Private source bytes never leave this browser.</div>',
    1,
)
source = source.replace(
    '<span class="pill"><i></i>Zero participant records</span>',
    '<span class="pill"><i></i>CASE 001 · 7 OBJECTS · 5 DECISIONS</span>',
    1,
)

old_hero = '''        <div class="hero">
          <div class="eyebrow">Start here · FAB Meeting #1 aftermath</div>
          <h1>This is the working case file for what the first FAB meeting created.</h1>
          <p class="plain-lead">It contains seven things worth preserving or resolving, five decisions that may deserve bounded executive attention, the source basis for each, and a local record of what this browser does with them. It does not contact anyone or assign anybody work.</p>
          <div class="start-actions"><button class="primary" id="startTourButton">Take the guided tour</button><button data-go="register">Open the seven case objects</button><button data-go="overview" class="ghost">Skip to the overview</button></div>
        