ng:15px;background:rgba(232,226,213,.42);border:0;border-right:1px solid var(--rule);border-bottom:1px solid var(--rule);font-family:var(--serif);line-height:1.55}.detail b{display:block;margin-bottom:6px;color:var(--accent-dp);font:700 .59rem/1.4 var(--mono);letter-spacing:.09em;text-transform:uppercase}

/* DECISIONS / RECEIPTS / QUEUES */
.decision-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.decision-card{display:flex;flex-direction:column;gap:12px;border-top:4px solid var(--ink)}.decision-card:nth-child(5){grid-column:1/-1}.decision-card .controls{margin-top:auto;padding-top:12px;border-top:1px solid var(--rule)}.controls{display:flex;gap:8px;flex-wrap:wrap}.controls button.active{background:var(--ink);color:var(--paper);border-color:var(--ink);box-shadow:3px 3px 0 var(--accent)}
.receipt-list,.draft-list,.queue-list{display:grid;gap:10px;min-width:0}.receipt,.draft,.queue-item{position:relative;min-width:0;padding:15px 17px;color:var(--ink);background:var(--paper-alt);border:1px solid var(--rule);border-left:4px solid var(--scope)}.receipt::after{content:"";position:absolute;right:-1px;top:14px;width:8px;height:18px;background:var(--paper);border-left:1px solid var(--rule)}.queue-item:has(.state.blocked){border-left-color:var(--ember)}.queue-item:has(.state.ready){border-left-color:var(--olive)}.receipt-head,.draft-head,.queue-head{display:flex;justify-content:space-between;gap:12px;align-items:start;min-width:0}.receipt-head>div,.draft-head>div,.queue-head>div{min-width:0}.receipt-head strong,.queue-head strong{font-family:var(--display);text-transform:uppercase;letter-spacing:.02em}.receipt code,.draft code{font-size:.66rem;color:var(--muted)}

/* RUNTIME SPINE + TABLE */
.function-spine{position:relative;display:flex;align-items:stretch;gap:0;overflow-x:auto;padding:20px 0 14px;border-top:2px solid var(--ink);border-bottom:1px solid var(--rule)}.function-spine::before{content:"";position:absolute;left:36px;right:36px;top:45px;height:2px;background:var(--rule-dk)}.spine-node{position:relative;z-index:1;flex:1 0 150px;padding:0 12px;text-align:center}.spine-node .spine-dot{display:grid;place-items:center;width:50px;height:50px;margin:0 auto 11px;color:var(--paper);background:var(--ink);border:5px solid var(--paper);outline:1px solid var(--ink);font:700 .64rem var(--mono)}.spine-node.pass .spine-dot{background:var(--safe);outline-color:var(--safe)}.spine-node.fail .spine-dot{background:var(--danger);outline-color:var(--danger)}.spine-node .spine-title{font-family:var(--display);font-size:.93rem;line-height:1;text-transform:uppercase}.spine-node .spine-id{margin-top:4px;color:var(--muted);font:600 .54rem var(--mono);letter-spacing:.04em}
.role-table{width:100%;border-collapse:collapse;background:transparent;border:0}.role-table th,.role-table td{padding:14px 13px;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule)}.role-table th{color:var(--bone);background:var(--void);font:700 .58rem/1.4 var(--mono);letter-spacing:.09em;text-transform:uppercase}.role-table td{font-family:var(--serif);font-size:.84rem}.role-table td:first-child strong{font-family:var(--display);font-size:1rem;text-transform:uppercase}.role-table tr:last-child td{border-bottom:0}.split{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(290px,.75fr);gap:18px}
.progress{height:12px;background:var(--paper-dk);border:1px solid var(--rule-dk);overflow:hidden}.progress>i{display:block;height:100%;width:0;background:repeating-linear-gradient(90deg,var(--safe) 0 18px,var(--olive) 18px 20px);transition:width .25s ease}

/* FORMS / SOURCES */
.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.form-grid .full{grid-column:1/-1}.field label{display:block;margin-bottom:5px;color:var(--muted);font:700 .61rem/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase}.field input,.field select{width:100%}
.file-drop{position:relative;padding:24px;background:var(--void);color:var(--bone);border:1px dashed var(--accent);box-shadow:inset 0 0 0 6px #12100c}.file-drop::before{content:"LOCAL CUSTODY";position:absolute;right:22px;top:18px;color:var(--olive);font:700 .58rem var(--mono);letter-spacing:.13em}.file-drop h3{color:var(--bone)}.file-drop .muted{color:var(--bone-dim)}.file-drop label{color:var(--bone-dim)}.file-drop input,.file-drop select{background:#ece7d8;color:var(--ink)}.file-drop input[type="file"]{width:100%}
.source-table{display:grid;gap:0;border-top:2px solid var(--ink)}.source-card{display:grid;grid-template-columns:minmax(190px,.78fr) minmax(240px,1.4fr) minmax(170px,.62fr);gap:18px;align-items:start;padding:17px 8px;border-bottom:1px solid var(--rule)}.source-card strong{font-family:var(--display);text-transform:uppercase}.source-card .support{color:var(--muted);font-family:var(--serif)}
.empty{padding:28px;text-align:center;color:var(--muted);background:var(--paper-alt);border:1px dashed var(--rule-dk);font-family:var(--serif)}

/* DIALOGS: a sealed folio, not a modal card */
dialog{max-width:790px;width:min(94vw,790px);padding:0;color:var(--ink);background:var(--paper);border:1px solid var(--bone);border-radius:0;box-shadow:0 34px 120px rgba(0,0,0,.64)}dialog::backdrop{background:rgba(5,5,4,.86);backdrop-filter:blur(5px)}.dialog-head{display:flex;justify-content:space-between;align-items:center;padding:18px 22px;color:var(--bone);background:var(--void);border-bottom:4px solid var(--accent)}.dialog-head h3{margin:0}.dialog-head .eyebrow{color:var(--accent-hi)}.dialog-head button{background:transparent;color:var(--bone);border-color:#554f40;box-shadow:2px 2px 0 #000}.dialog-body{padding:24px;max-height:70vh;overflow:auto}.help-dialog{max-width:980px;width:min(95vw,980px)}.help-dialog .dialog-body{max-height:74vh}.help-intro{padding:0 0 18px;border-bottom:2px solid var(--ink);color:var(--ink-2);font-family:var(--serif);font-size:1.05rem}.help-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;margin:18px 0;border-top:1px solid var(--rule);border-left:1px solid var(--rule)}.help-columns .card{border:0;border-right:1px solid var(--rule);border-bottom:1px solid var(--rule)}.help-actions{display:flex;gap:9px;flex-wrap:wrap;padding:17px 22px;border-top:1px solid var(--rule);background:var(--paper-alt)}
.toast{position:fixed;right:20px;bottom:20px;z-index:999;max-width:min(440px,calc(100vw - 40px));padding:14px 17px;color:var(--bone);background:var(--void);border:1px solid var(--accent);box-shadow:8px 8px 0 rgba(0,0,0,.5);opacity:0;transform:translateY(12px);pointer-events:none;transition:.2s;font:600 .72rem/1.5 var(--mono)}.toast.show{opacity:1;transform:none}
footer{margin-top:52px;padding:18px 0 0;color:var(--muted);border-top:3px double var(--ink);font:400 .61rem/1.7 var(--mono);letter-spacing:.025em}

@media (max-width:1180px){.app{grid-template-columns:220px minmax(0,1fr)}.rail{padding-inline:15px}.brand{grid-template-columns:52px 1fr}.mark{width:52px;height:62px}.grid.four{grid-template-columns:repeat(2,minmax(0,1fr))}#startMetrics .card:nth-child(2),#overviewMetrics .card:nth-child(2),#runtimeMetrics .card:nth-child(2),#ledgerMetrics .card:nth-child(2){border-right:0}.offer-row{grid-template-columns:1fr 110px 100px}.offer-row .offer-summary{grid-column:1/-1}.split{grid-template-columns:1fr}.grid.three{grid-template-columns:repeat(2,minmax(0,1fr))}.hero.dossier-cover{grid-template-columns:minmax(0,1fr) 220px}}
@media (max-width:780px){
  .app{display:block}.rail{position:relative;height:auto;padding:13px 14px 10px;gap:11px;border-right:0;border-bottom:1px solid var(--void-line)}.rail::before{display:none}.brand{grid-template-columns:42px 1fr;padding:0 0 10px}.mark{width:42px;height:48px}.mark svg{width:31px}.brand strong{font-size:1.05rem}.brand small{margin-top:4px}.boundary,.rail-footer{display:none}.seat-nav{display:flex;overflow-x:auto;border-top:1px solid var(--void-line);scrollbar-width:thin}.seat-nav button{min-width:max-content;grid-template-columns:25px 1fr;border-right:1px solid var(--void-line);border-bottom:0;padding:.6rem .7rem}.seat-nav button[aria-selected="true"]{padding-left:.7rem}.seat-nav button[aria-selected="true"]::after{top:auto;left:0;right:0;bottom:0;width:auto;height:3px}.topbar{position:sticky;padding:9px 11px}.topbar .pill:nth-child(n+2){display:none}.top-actions #importPacketButton{display:none}.content{padding:14px 10px 48px}.view{min-height:0;padding:22px 16px}.view::before,.view::after{display:none}.hero{padding:27px 20px;margin-bottom:30px}.hero.dossier-cover{display:block}.cover-sigil{display:none}h1{font-size:clamp(2.7rem,15vw,4.5rem)}h2{font-size:2rem}.grid.two,.grid.three,.grid.four,.decision-grid,.details-grid,.form-grid{grid-template-columns:1fr}#startMetrics,#overviewMetrics,#runtimeMetrics,#ledgerMetrics{grid-template-columns:repeat(2,1fr)}#startMetrics .card,#overviewMetrics .card,#runtimeMetrics .card,#ledgerMetrics .card{border-right:1px solid var(--rule);border-bottom:1px solid var(--rule)}.start-summary,.start-inventory,.glossary{grid-template-columns:1fr}.case-map-head{display:block;padding:20px}.case-map{min-width:760px}.case-map-legend{padding-inline:20px}.journey-step{grid-template-columns:50px minmax(0,1fr);gap:10px}.journey-step button{grid-column:2}.offer-row{grid-template-columns:1fr;padding:14px 8px}.offer-row .offer-summary{grid-column:auto}.source-card{grid-template-columns:1fr}.section-head{display:block;padding-top:14px}.section-head>p{margin-top:8px}.tour-bar{position:relative;top:auto;padding:11px 14px;align-items:flex-start;display:block}.tour-controls{margin-top:10px}.help-columns{grid-template-columns:1fr}.decision-card:nth-child(5){grid-column:auto}.receipt-head,.queue-head{align-items:flex-start}.file-drop::before{position:static;display:block;margin-bottom:10px}.top-actions button{min-height:34px;padding:.5rem .55rem}.top-actions #helpButton{display:inline-block}
}
@media (max-width:430px){.topbar-group:first-child .pill{font-size:.54rem}.top-actions #exportPacketButton{font-size:0}.top-actions #exportPacketButton::after{content:"EXPORT";font-size:.62rem}.case-map{min-width:680px}.content{padding-inline:7px}.view{padding-inline:13px}.hero{padding-inline:17px}}
@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
@media print{body{background:#fff;color:#000}.rail,.topbar,.skip,.toast,button,.toolbar,.file-drop,.tour-bar{display:none!important}.app{display:block}.content{padding:0}.view{display:block!important;box-shadow:none;border:0;min-height:0;page-break-after:always}.hero{box-shadow:none}.card{break-inside:avoid}.case-map-shell{break-inside:avoid}}
