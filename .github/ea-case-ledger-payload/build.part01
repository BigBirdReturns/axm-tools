case_map = '''        <section class="case-map-shell" aria-labelledby="caseMapTitle">
          <div class="case-map-head"><div><div class="eyebrow">The diagram is the argument</div><h2 id="caseMapTitle">One case, seven live administrative objects</h2></div><p>Each object retains its own evidentiary force. The lines show shared custody inside the FAB aftermath case, not authority, assignment, or obligation.</p></div>
