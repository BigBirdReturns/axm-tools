          <div class="case-map-legend"><span style="color:var(--safe)"><i></i>accepted / completed</span><span style="color:var(--steel)"><i></i>offered</span><span style="color:var(--held)"><i></i>held</span><span style="color:var(--violet)"><i></i>mentioned / unresolved</span></div>
