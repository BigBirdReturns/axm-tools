urce.replace(
    "  $$('[data-start-offer]').forEach(button=>button.addEventListener('click',()=>{selectedOfferId=button.dataset.startOffer;showView('register');renderRegister()}));\n}",
    "  $$('[data-start-offer]').forEach(button=>button.addEventListener('click',()=>{selectedOfferId=button.dataset.startOffer;showView('register');renderRegister()}));\n  renderCaseMap();\n}",
    1,
)
old_runtime = "  $('#roleTableBody').innerHTML=cartridge.role_profiles.map(r=>{const result=roleResult(r.id);return `<tr><td><strong>${esc(r.alias)}</strong><br><code>${esc(r.id)}</code></td><td>${esc(r.fn)}</td><td>${esc(r.need)}</td><td>${esc(r.authority)}</td><td>${result?`<span class=\"state ${result.status==='pass'?'ready':'blocked'}\">${esc(result.status)}</span><br><span class=\"fine\">${esc(result.detail)}</span>`:'<span class=\"state open\">not run</span>'}</td></tr>`}).join('');"
new_runtime = old_runtime + "\n  $('#functionSpine').innerHTML=cartridge.role_profiles.map((r,index)=>{const result=roleResult(r.id);const status=result?.status||'idle';return `<div class=\"spine-node ${esc(status)}\"><div class=\"spine-dot\">${String(index+1).padStart(2,'0')}</div><div class=\"spine-title\">${esc(r.alias.replace(/ \\/ .*/,''))}</div><div class=\"spine-id\">${esc(r.id)}</div></div>`}).join('');"
if old_runtime not in source:
    raise SystemExit("Runtime renderer seam missing")
source = source.replace(old_runtime, new_runtime, 1)
HTML.write_text(source, encoding="utf-8")

# App documentation and identity registry.
readme_path = ROOT / "essential-attention/README.md"
readme = readme_path.read_text(encoding="utf-8")
readme = readme.replace("This release opens", "Version 1.0.4 opens", 1)
visual = '''
## Visual floor

Essential Attention uses the **Case Ledger** flavor registered for AXM properties. It is a Cream Editorial administrative dossier carried inside a Dark Ecosystem custody spine. The reusable visual law is:

- exact SCG 16×18 practice-derivative pixel mark, never redrawn or smoothed;
- frozen SCG bone `#ECE7D8`, olive `#7C7F57`, void `#0D0C09`, and ember `#C24B2C`;
- ember only for blocked or adverse findings;
- Barlow Condensed for display, IBM Plex Sans for running interface text, IBM Plex Mono for evidence, and Lora for explanatory narrative;
- dark custody and instrument surfaces surrounding a paper case file;
- case maps, rules, docket rows, evidence wells, state stamps, and case numbers instead of generic SaaS cards and decorative pills;
- FAB supplies the case vocabulary and records, while the Case Ledger shell remains reusable by later cartridges.

The font subsets and mark coordinates are embedded from the estate's frozen identity artifacts. The page makes no font or asset request at runtime.
'''
insert_at = readme.find("\n## What loads when the page opens")
if insert_at < 0:
    raise SystemExit("README insertion seam missing")
readme = readme[:insert_at] + visual + readme[insert_at:]
readme_path.write_text(readme, encoding="utf-8")

flavor_path = ROOT / "identity/axm/PROPERTY-FLAVORS.md"
flavors = flavor_path.read_text(encoding="utf-8")
row = '| **Essential Attention** | `…/axm-tools/essential-attention/` | **Cream Editorial case ledger inside Dark Ecosystem custody** | paper `#F0EBE0` inside void `#0D0C09` | **olive `#7C7F57` custody + amber case emphasis; ember only for blocks** | The administrative case file is a governed dossier, not a generic SaaS dashboard. Exact SCG mark, case topology, docket rows, evidence wells, and mono receipts carry the estate identity while the cartridge remains white-label. |\n'
if "| **Essential Attention** |" not in flavors:
    needle = "| surface acceptance (on axm-tools)"
    pos = flavors.find(needle)
    if pos < 0:
        raise SystemExit("Property flavor seam missing")
    end = flavors.find("\n", pos) + 1
    flavors = flavors[:end] + row + flavors[end:]
flavor_path.write_text(flavors, encoding="utf-8")

root_readme = ROOT / "README.md"
root_text = root_readme.read_text(encoding="utf-8")
old = "| [`essential-attention/`](essential-attention/) | Local-first FAB aftermath case file: seven source-linked administrative objects, five bounded decisions, contained functional seats, guided first use, cold handoff, and portable export without external-effect adapters | [standalone FAB runtime](https://bigbirdreturns.github.io/axm-tools/essential-attention/) — opens with Start here, first-run help, and a guided tour |"
new = "| [`essential-attention/`](essential-attention/) | AXM Case Ledger for the FAB aftermath: exact SCG mark, case topology, dark custody shell, paper dossier, seven source-linked objects, five bounded decisions, contained functional seats, guided first use, cold handoff, and portable export without external-effect adapters | [standalone FAB case ledger](https://bigbirdreturns.github.io/axm-tools/essential-attention/) — opens with Start here, first-run help, and a guided tour |"
if old not in root_text:
    raise SystemExit("Root README tool row seam missing")
root_readme.write_text(root_text.replace(old, new, 1), encoding="utf-8")

root_index = ROOT / "index.html"
index_text = root_index.read_text(encoding="utf-8")
old_block = '''<div class="tool">
  <div class="title"><a href="essential-attention/">Essential Attention · FAB Runtime</a></div>
  <div class="desc">The working case file for the aftermath of FAB Meeting #1. It opens with
    first-run help and a guided route through seven source-bound objects, five bounded decisions,
    contained functional seats, local source hashing, successor replay, and portable export.
    No backend and no email, calendar, payment, publication, or other external-effect adapter.</div>
  <a class="open" href="essential-attention/">Open the FAB runtime →</a>
</div>'''
new_block = '''<div class="tool">
  <div class="title"><a href="essential-attention/">Essential Attention · FAB Case Ledger</a></div>
  <div class="desc">The AXM Case Ledger for the aftermath of FAB Meeting #1. A dark custody shell
    carries a paper administrative dossier through seven source-bound objects, five bounded decisions,
    a live case map, contained functional seats, local source hashing, successor replay, and portable
    export. The frozen SCG mark and house type travel inside the one-file runtime.</div>
  <a class="open" href="essential-attention/">Open the FAB case ledger →</a>
</div>'''
if old_block not in index_text:
    raise SystemExit("Root index tool block seam missing")
root_index.write_text(index_text.replace(old_block, new_block, 1), encoding="utf-8")

# Qualification test raises the visual floor into the release contract.
test_path = ROOT / "essential-attention/tests/public_contract_test.py"
test = test_path.read_text(encoding="utf-8")
test = test.replace("release_1_0_3", "release_1_0_4").replace("1.0.3", "1.0.4")
marker = '    "readme_contents": "The default FAB cartridge contains seven case objects" in readme,'
checks = '''    "case_ledger_flavor": "FAB Case Ledger" in source and "pixel-dandelion" in source,
    "case_topology": "case-map-shell" in source and "function-spine" in source,
    "embedded_house_fonts": all(token in source for token in ["Barlow Condensed", "IBM Plex Mono", "IBM Plex Sans", "Lora"]) and "font-src data:" in source,
    "frozen_palette": all(token in source for token in ["#0D0C09", "#ECE7D8", "#7C7F57", "#C24B2C"]),
'''
if marker not in test:
    raise SystemExit("Qualification check seam missing")
test = test.replace(marker, checks + marker, 1)
test = test.replace(
    '"operator_surface": "plain standalone HTML with first-run orientation",',
    '"operator_surface": "AXM Case Ledger with first-run orientation",',
)
test_path.write_text(test, encoding="utf-8")

print(f"Built Essential Attention v1.0.4 Case Ledger: {HTML.stat().st_size} bytes")
