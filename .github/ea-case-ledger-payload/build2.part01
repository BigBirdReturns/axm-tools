metrics_section = '''        <section class="section">
          <div class="section-head"><div><div class="eyebrow">What is already here</div><h2>One loaded case, not an empty platform</h2></div><p>The public page opens with a sanitized reconstruction of the FAB aftermath. Private source files are optional and remain local to your browser.</p></div>
