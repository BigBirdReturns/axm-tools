case_map_js = r'''function mapStateColor(stateName){
  return ({accepted:'#7C7F57',completed:'#7C7F57',ready:'#7C7F57',offered:'#587584',pending:'#587584',held:'#c9923e',blocked:'#C24B2C',mentioned:'#8b7199',open:'#8b7199',declined:'#C24B2C',stopped:'#C24B2C'})[stateName]||'#8f877b';
}
function svgTitleLines(title,max=23){
  const words=String(title).split(/\s+/);const lines=[''];
  for(const word of words){const i=lines.length-1;const next=(lines[i]+' '+word).trim();if(next.length>max&&lines[i]&&lines.length<3)lines.push(word);else lines[i]=next}
  return lines.slice(0,3);
}
