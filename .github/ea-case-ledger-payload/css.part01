 1px);
  background-size:24px 24px;
  mask-image:linear-gradient(90deg,transparent 0%,black 58%,black 100%);
}
.hero>*{position:relative;z-index:2}
.hero.dossier-cover{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(230px,.5fr);gap:38px;align-items:end}
.cover-copy{min-width:0}.cover-index{font:600 .66rem/1.5 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--bone-faint);margin-bottom:20px}
.cover-sigil{display:grid;place-items:end center;align-self:stretch;border-left:1px solid #343026;padding-left:32px;min-width:0}
.cover-sigil svg{width:min(100%,210px);height:auto;shape-rendering:crispEdges;filter:drop-shadow(0 12px 20px rgba(0,0,0,.3))}
.cover-tally{width:100%;margin-top:24px;border-top:1px solid #3a372d;padding-top:14px;display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.cover-tally span{font:600 .58rem/1.45 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--bone-faint)}
.cover-tally b{display:block;font-family:var(--display);font-size:1.45rem;color:var(--bone)}
.eyebrow{
  text-transform:uppercase;
  letter-spacing:.145em;
  font:700 .64rem/1.4 var(--mono);
  color:var(--accent-dp);
}
.hero .eyebrow{color:var(--accent-hi);display:flex;align-items:center;gap:12px}.hero .eyebrow::before{content:"";width:30px;height:2px;background:var(--accent)}
h1{
  max-width:1080px;
  margin:.52rem 0 1rem;
  font-family:var(--display);
  font-size:clamp(3rem,7vw,6.8rem);
  font-weight:900;
  line-height:.87;
  letter-spacing:-.025em;
  text-transform:uppercase;
}
h1 .accent{color:var(--accent-hi)}
h2{
  margin:.2rem 0 .55rem;
  font-family:var(--display);
  font-size:clamp(1.9rem,3.8vw,3.35rem);
  font-weight:900;
  line-height:.93;
  letter-spacing:-.015em;
  text-transform:uppercase;
}
h3{font-family:var(--display);font-size:1.35rem;line-height:1.04;letter-spacing:.01em;text-transform:uppercase;margin:.15rem 0 .55rem}
h4{font-family:var(--mono);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;margin:.1rem 0 .45rem}
p{margin:.45rem 0}.hero>p,.hero .plain-lead{max-width:850px;color:var(--bone-dim);font-family:var(--serif);font-size:1.05rem;line-height:1.65}.plain-lead{max-width:900px;color:var(--bone-dim)}
.start-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.hero .start-actions button:not(.primary){background:transparent;color:var(--bone);border-color:#5a5445;box-shadow:3px 3px 0 #000}.hero .start-actions button:hover{border-color:var(--accent)}

.notice,.warning,.success{position:relative;margin-top:20px;padding:15px 17px 15px 20px;border:1px solid;border-left-width:4px;font-family:var(--serif);font-size:.91rem;line-height:1.58}
.notice{border-color:#8799a1;border-left-color:var(--steel);background:var(--steel-lt)}
.warning{border-color:#c7aa78;border-left-color:var(--held);background:var(--held-lt)}
.success{border-color:#9aa484;border-left-color:var(--safe);background:var(--safe-lt)}
.hero .notice{color:var(--bone);border-color:#343c40;border-left-color:var(--steel);background:rgba(88,117,132,.16)}
.section{margin:44px 0}.section-head{display:flex;justify-content:space-between;gap:28px;align-items:end;margin-bottom:18px;padding-top:18px;border-top:2px solid var(--ink)}.section-head>p{max-width:600px;color:var(--muted);font-family:var(--serif)}
.section-head h2{margin-bottom:0}
.grid{display:grid;gap:14px}.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.grid.four{grid-template-columns:repeat(4,minmax(0,1fr))}

.card{
  position:relative;
  min-width:0;
  padding:20px;
  color:var(--ink);
  background:rgba(240,235,224,.76);
  border:1px solid var(--rule);
  box-shadow:none;
}
.card::after{content:"";position:absolute;left:-1px;top:-1px;width:24px;height:3px;background:var(--scope)}
.card.selected{border:2px solid var(--ink);box-shadow:8px 8px 0 var(--accent-mid)}
.card.selected::after{background:var(--accent);height:5px;width:62px}

/* Stat strips: numbers should read as evidence, not dashboard chrome */
#startMetrics,#overviewMetrics,#runtimeMetrics,#ledgerMetrics{gap:0;border-top:2px solid var(--ink);border-bottom:1px solid var(--rule)}
#startMetrics .card,#overviewMetrics .card,#runtimeMetrics .card,#ledgerMetrics .card{border:0;border-right:1px solid var(--rule);background:transparent;padding:20px 22px}
#startMetrics .card:last-child,#overviewMetrics .card:last-child,#runtimeMetrics .card:last-child,#ledgerMetrics .card:last-child{border-right:0}
.metric b{display:block;margin-bottom:7px;color:var(--ink);font:900 2.8rem/.85 var(--display);font-variant-numeric:tabular-nums}.metric span{color:var(--muted);font:700 .58rem/1.4 var(--mono);letter-spacing:.11em;text-transform:uppercase}

.state{display:inline-flex;align-items:center;gap:6px;padding:.29rem .48rem;border:1px solid currentColor;background:transparent;font:700 .58rem/1 var(--mono);letter-spacing:.095em;text-transform:uppercase;white-space:nowrap}
.state::before{content:"";width:6px;height:6px;background:currentColor}
.state.accepted,.state.completed,.state.ready{color:var(--safe);background:var(--safe-lt)}
.state.offered,.state.pending{color:var(--steel);background:var(--steel-lt)}
.state.held{color:var(--held);background:var(--held-lt)}
.state.blocked,.state.declined,.state.stopped{color:var(--danger);background:var(--danger-lt)}
.state.mentioned,.state.open{color:var(--violet);background:var(--violet-lt)}
.meta{display:flex;gap:7px;flex-wrap:wrap;margin:9px 0 13px}.meta span{max-width:100%;padding:.3rem .46rem;color:var(--muted);background:var(--paper-alt);border:1px solid var(--rule);font:600 .59rem/1.3 var(--mono);letter-spacing:.035em;overflow-wrap:anywhere;word-break:break-word}.muted{color:var(--muted);font-family:var(--serif)}.fine{color:var(--muted);font:400 .68rem/1.5 var(--mono);overflow-wrap:anywhere;word-break:break-word}
.toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:18px 0}.toolbar input[type="search"]{flex:1;min-width:230px}.toolbar .grow{flex:1}

/* START HERE / CASE MAP */
.start-summary{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(300px,.8fr);gap:18px;align-items:start}.start-inventory{counter-reset:inventory;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;border-top:1px solid var(--ink);border-left:1px solid var(--rule)}
.inventory-card{counter-increment:inventory;position:relative;min-width:0;padding:18px 18px 18px 50px;background:transparent;border:0;border-right:1px solid var(--rule);border-bottom:1px solid var(--rule)}
.inventory-card::before{content:counter(inventory,decimal-leading-zero);position:absolute;left:16px;top:18px;color:var(--accent-dp);font:700 .62rem var(--mono);letter-spacing:.08em}.inventory-card .receipt-head{margin-bottom:8px}.inventory-card p{color:var(--muted);font-family:var(--serif);font-size:.88rem}.inventory-card button{margin-top:8px}
.case-map-shell{margin:44px 0;color:var(--bone);background:var(--void);border:1px solid #2d2a22;box-shadow:0 20px 48px rgba(0,0,0,.24)}
.case-map-head{display:flex;justify-content:space-between;gap:24px;align-items:end;padding:24px 28px 18px;border-bottom:1px solid #2d2a22}.case-map-head h2{color:var(--bone);margin:0}.case-map-head p{max-width:520px;color:var(--bone-dim);font:400 .72rem/1.55 var(--mono)}.case-map-scroll{overflow-x:auto;overflow-y:hidden}.case-map{min-width:920px;padding:16px 24px 24px}.case-map svg{display:block;width:100%;height:auto;min-height:470px}.case-map .map-line{stroke:#4a4538;stroke-width:1.5}.case-map .map-line.hot{stroke:var(--accent);stroke-width:2}.case-map .map-node{cursor:pointer}.case-map .map-node rect{fill:#15130f;stroke:#5d584b;stroke-width:1.2}.case-map .map-node:hover rect,.case-map .map-node:focus rect{stroke:var(--accent-hi);stroke-width:2}.case-map .map-node .node-index{font:700 10px var(--mono);fill:var(--accent-hi);letter-spacing:1px}.case-map .map-node .node-title{font:800 14px var(--display);fill:var(--bone);letter-spacing:.5px}.case-map .map-node .node-state{font:700 9px var(--mono);letter-spacing:1px}.case-map .map-core{fill:#090806;stroke:var(--accent);stroke-width:2}.case-map .core-ring{fill:none;stroke:#3f3a2f;stroke-width:1}.case-map .core-kicker{font:700 10px var(--mono);fill:var(--olive);letter-spacing:2px}.case-map .core-title{font:900 30px var(--display);fill:var(--bone);letter-spacing:1px}.case-map .core-sub{font:600 9px var(--mono);fill:var(--bone-faint);letter-spacing:1.4px}.case-map-legend{display:flex;gap:18px;flex-wrap:wrap;padding:13px 28px 18px;border-top:1px solid #2d2a22;color:var(--bone-faint);font:600 .58rem var(--mono);letter-spacing:.06em;text-transform:uppercase}.case-map-legend span{display:flex;align-items:center;gap:7px}.case-map-legend i{width:8px;height:8px;background:currentColor}

.journey{counter-reset:journey;display:grid;gap:0;border-top:2px solid var(--ink)}.journey-step{counter-increment:journey;position:relative;display:grid;grid-template-columns:64px minmax(0,1fr) auto;gap:18px;align-items:center;padding:18px 0;border-bottom:1px solid var(--rule);background:transparent}.journey-step::before{content:counter(journey,decimal-leading-zero);display:grid;place-items:center;width:44px;height:44px;color:var(--paper);background:var(--ink);font:800 .74rem var(--mono);box-shadow:5px 5px 0 var(--accent-mid)}.journey-step strong{font-family:var(--display);font-size:1.08rem;text-transform:uppercase;letter-spacing:.02em}.journey-step p{margin:3px 0 0;color:var(--muted);font-family:var(--serif);font-size:.88rem}.glossary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;margin:0;border-top:1px solid var(--rule);border-left:1px solid var(--rule)}.glossary>div{padding:14px;background:transparent;border-right:1px solid var(--rule);border-bottom:1px solid var(--rule)}.glossary dt{font-family:var(--display);font-size:1rem;text-transform:uppercase}.glossary dd{margin:4px 0 0;color:var(--muted);font-family:var(--serif)}

/* REGISTER */
.offer-list{display:grid;gap:0;border-top:2px solid var(--ink)}.offer-row{position:relative;display:grid;grid-template-columns:minmax(210px,1.1fr) minmax(105px,.5fr) minmax(100px,.45fr) minmax(250px,1.4fr);gap:16px;align-items:center;min-width:0;padding:16px 12px;background:transparent;border:0;border-bottom:1px solid var(--rule);cursor:pointer}.offer-row::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:transparent}.offer-row:hover{background:var(--scope-lt)}.offer-row strong{display:block;font-family:var(--display);font-size:1.05rem;text-transform:uppercase}.offer-row code{display:block;color:var(--dim);margin-top:4px;font-size:.65rem}.offer-row p{margin:0;color:var(--muted);font-family:var(--serif);font-size:.86rem}.offer-row[aria-current="true"]{background:var(--accent-lt)}.offer-row[aria-current="true"]::before{background:var(--accent)}
.details{margin-top:18px}.details-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;border-top:1px solid var(--rule);border-left:1px solid var(--rule)}.detail{paddi