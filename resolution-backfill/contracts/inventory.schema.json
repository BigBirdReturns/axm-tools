{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/axm-tools/resolution-backfill/contracts/inventory.schema.json",
  "title": "AXM resolution backfill inventory",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "base_ref",
    "base_sha",
    "policy",
    "surfaces"
  ],
  "properties": {
    "schema": {
      "const": "axm-tools/resolution-backfill-inventory@1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "base_ref": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "policy": {
      "type": "object"
    },
    "donors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "paths",
          "current_claim",
          "claim_evidence",
          "resolution_status",
          "evidence_tier",
          "actors",
          "mechanism",
          "gates",
          "findings",
          "assets_required",
          "next_gate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "class": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "current_claim": {
            "type": "string",
            "minLength": 20
          },
          "claim_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "resolution_status": {
            "enum": [
              "reopened",
              "remediation_in_progress",
              "qualified",
              "retired"
            ]
          },
          "evidence_tier": {
            "type": "string",
            "minLength": 1
          },
          "actors": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "mechanism": {
            "type": "string",
            "minLength": 20
          },
          "gates": {
            "type": "object",
            "required": [
              "object_classification",
              "actors_authority",
              "source_custody",
              "mechanism_fidelity",
              "live_data_failure_states",
              "interaction_semantics",
              "visual_typography",
              "responsive_accessibility",
              "negative_stress_offline",
              "continuity_export_succession",
              "provenance_rights_privacy",
              "qualification_receipts"
            ],
            "additionalProperties": {
              "enum": [
                "pass",
                "partial",
                "fail",
                "unknown",
                "not_applicable"
              ]
            }
          },
          "findings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "severity",
                "title",
                "mechanism",
                "evidence",
                "acceptance"
              ],
              "properties": {
                "severity": {
                  "enum": [
                    "critical",
                    "high",
                    "medium",
                    "low"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 10
                },
                "mechanism": {
                  "type": "string",
                  "minLength": 20
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "acceptance": {
                  "type": "string",
                  "minLength": 20
                }
              }
            }
          },
          "assets_required": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "next_gate": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  }
}
