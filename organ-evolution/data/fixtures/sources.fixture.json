{
  "format": "axm-organ-sources/1",
  "rules": {
    "staleCommitDays": 30,
    "staleDraftDays": 10,
    "staleWorkflowDays": 14
  },
  "organs": [
    {
      "organId": "organ.genesis",
      "repositories": [
        {
          "fullName": "BigBirdReturns/axm-genesis",
          "workflowPolicy": {
            "declarations": [
              {
                "matchName": "ci",
                "role": "permanent_gate",
                "lifecycle": "current",
                "required": true,
                "basis": "Fixture current gate."
              }
            ]
          }
        }
      ]
    },
    {
      "organId": "organ.bloodstream",
      "repositories": [
        {
          "fullName": "BigBirdReturns/axm-bloodstream",
          "workflowPolicy": {
            "declarations": [
              {
                "matchName": "ci",
                "role": "permanent_gate",
                "lifecycle": "current",
                "required": true,
                "basis": "Fixture required circulation gate."
              }
            ]
          }
        }
      ]
    }
  ]
}
