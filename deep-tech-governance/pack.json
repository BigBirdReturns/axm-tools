{
  "schema": "axm/deep-tech-governance-pack@1",
  "pack_id": "AXM-DEEPTECH-001",
  "version": "1.0.0",
  "status": "PORTABILITY_BASELINE",
  "purpose": "Target-neutral governance pack for small defense, robotics, autonomy, maritime, aerospace, industrial, and other deep-technology startups with complex public evidence surfaces.",
  "target_selection": {"human_required": true, "automatic_discovery": false, "machine_may_rank_unselected_targets": false, "selection_receipt_required": true},
  "public_boundary": {"public_observation_is_company_truth": false, "private_source_bytes_allowed_in_public_release": false, "external_effect_adapters": 0, "unknown_state_policy": "retain_visible", "private_admission_required_for": ["executed_private_instruments", "internal_counterparties", "cap_table_and_financial_records", "nonpublic_technical_evidence", "actual_signing_and_publishing_authority", "private_system_access", "organizational_adoption"]},
  "outputs": [
    {"id":"OUT-001","name":"Public Baseline","purpose":"What can an outsider responsibly establish from bounded public evidence?"},
    {"id":"OUT-002","name":"Diligence Map","purpose":"What matters, what is corroborated, what conflicts, and what remains unresolved?"},
    {"id":"OUT-003","name":"Admission Map","purpose":"What exact company-controlled records or authority assertions would resolve the material gaps?"},
    {"id":"OUT-004","name":"Operating Readiness","purpose":"What evidence, authority, configuration, and technical invariants must exist before claims or operations can advance?"}
  ],
  "state_tracks": ["relationship","instrument","consideration","capital","capability","claim","evidence","rights","authority","decision","exception"],
  "transfer_controls": [
    {"id":"DTP-001","domain":"government","rule":"Selection is not award.","prohibited_upgrade":"program_selection_to_contract_or_customer"},
    {"id":"DTP-002","domain":"commercial","rule":"Contract ceiling is not revenue.","prohibited_upgrade":"ceiling_to_recognized_or_received_revenue"},
    {"id":"DTP-003","domain":"technical","rule":"Demonstration is not deployment.","prohibited_upgrade":"demo_to_operational_deployment"},
    {"id":"DTP-004","domain":"technical","rule":"Simulation is not field performance.","prohibited_upgrade":"simulation_to_physical_performance"},
    {"id":"DTP-005","domain":"integration","rule":"Partner capability is not startup capability until integration is evidenced.","prohibited_upgrade":"partner_capability_to_owned_or_integrated_capability"},
    {"id":"DTP-006","domain":"government","rule":"Government interest is not procurement.","prohibited_upgrade":"conversation_or_interest_to_procurement"},
    {"id":"DTP-007","domain":"legal","rule":"Export status remains held until established by an attributable authority or qualified analysis.","prohibited_upgrade":"assumption_to_export_classification"},
    {"id":"DTP-008","domain":"transaction","rule":"Signed is not automatically effective, funded, or performed.","prohibited_upgrade":"signature_to_effectiveness_funding_or_performance"},
    {"id":"DTP-009","domain":"relationship","rule":"A non-binding MOU is not a customer, award, exclusivity grant, or integrated product.","prohibited_upgrade":"mou_to_traction_or_capability"},
    {"id":"DTP-010","domain":"events","rule":"Invitation or event occurrence is not attendance, endorsement, selection, or procurement.","prohibited_upgrade":"event_metadata_to_target_participation_or_validation"},
    {"id":"DTP-011","domain":"technical","rule":"One successful test is not repeatability.","prohibited_upgrade":"single_run_to_repeatable_or_ready"},
    {"id":"DTP-012","domain":"technical","rule":"Prototype is not pilot-ready.","prohibited_upgrade":"prototype_to_customer_readiness"},
    {"id":"DTP-013","domain":"technical","rule":"Design intent is not current specification.","prohibited_upgrade":"roadmap_or_render_to_current_configuration"},
    {"id":"DTP-014","domain":"evidence","rule":"Component proof is not system proof.","prohibited_upgrade":"component_evidence_to_platform_qualification"},
    {"id":"DTP-015","domain":"authority","rule":"Public title or affiliation does not grant speaking, signing, publishing, or decision authority.","prohibited_upgrade":"title_to_delegated_authority"},
    {"id":"DTP-016","domain":"capital","rule":"Financing announcement or executed instrument is not cleared funds.","prohibited_upgrade":"announcement_or_signature_to_cash_received"},
    {"id":"DTP-017","domain":"ip","rule":"Public ownership language is not chain-of-title proof.","prohibited_upgrade":"terms_clause_to_verified_title_or_enforceability"},
    {"id":"DTP-018","domain":"data","rule":"AI-generated or synthetic media is not physical configuration or field evidence.","prohibited_upgrade":"synthetic_content_to_observed_world_state"},
    {"id":"DTP-019","domain":"search","rule":"A bounded search miss is coverage evidence, not universal absence.","prohibited_upgrade":"no_match_to_nonexistence"},
    {"id":"DTP-020","domain":"source_integrity","rule":"Flattened extraction cannot override semantic page structure when layout changes meaning.","prohibited_upgrade":"adjacent_text_to_structured_fact"},
    {"id":"DTP-021","domain":"claims","rule":"Marketing language cannot upgrade maturity without new admitted evidence.","prohibited_upgrade":"wording_strength_to_evidence_strength"},
    {"id":"DTP-022","domain":"rights","rule":"Introductions, contributions, public posts, and proximity create no rights absent an instrument.","prohibited_upgrade":"relationship_to_ownership_license_or_exclusivity"},
    {"id":"DTP-023","domain":"authority","rule":"The control surface records authority; it does not create authority.","prohibited_upgrade":"tool_record_to_company_power"},
    {"id":"DTP-024","domain":"continuity","rule":"Corrections, withdrawals, rejected states, and superseded objects remain inspectable.","prohibited_upgrade":"current_projection_to_erased_history"}
  ],
  "successor_event_classes": [
    {"id":"EVT-001","name":"financing","material_if":["new_instrument","new_investor_controlled_confirmation","funds_received","terms_changed"]},
    {"id":"EVT-002","name":"leadership_or_authority","material_if":["new_role","role_removed","authority_changed","signatory_changed"]},
    {"id":"EVT-003","name":"technical_test","material_if":["new_configuration","new_environment","new_acceptance_result","independent_test"]},
    {"id":"EVT-004","name":"partnership_or_integration","material_if":["instrument_changed","work_started","integration_evidenced","acceptance_record"]},
    {"id":"EVT-005","name":"customer_or_procurement","material_if":["named_customer","pilot","award","contract","acceptance","revenue_evidence"]},
    {"id":"EVT-006","name":"legal_or_registry","material_if":["entity_record","standing_change","filing","ip_record","authority_record"]},
    {"id":"EVT-007","name":"technical_publication","material_if":["new_evidence","new_limitation","configuration_disclosed","claim_corrected"]},
    {"id":"EVT-008","name":"claim_correction","material_if":["source_conflict","withdrawal","supersession","ingestion_defect"]},
    {"id":"EVT-009","name":"security_or_export","material_if":["classification","restriction","license","incident","access_change"]}
  ],
  "technical_evidence_minimum": ["subject_id","hardware_revision","software_revision","model_or_policy_revision","sensor_and_calibration_refs","environment","procedure","telemetry_refs","acceptance_criteria","result","limitations","authority_ref","source_refs"],
  "portability_acceptance_gates": [
    {"id":"GATE-001","test":"human_selected_target_receipt_present"},
    {"id":"GATE-002","test":"zero_target_specific_code_changes"},
    {"id":"GATE-003","test":"bounded_public_acquisition_receipts_present"},
    {"id":"GATE-004","test":"strict_governed_state_valid"},
    {"id":"GATE-005","test":"sector_transfer_controls_applied"},
    {"id":"GATE-006","test":"four_required_outputs_compile"},
    {"id":"GATE-007","test":"technical_readiness_gaps_explicit"},
    {"id":"GATE-008","test":"deterministic_release_rebuild"},
    {"id":"GATE-009","test":"successor_event_delta_compiles"},
    {"id":"GATE-010","test":"private_state_and_external_effects_absent"}
  ],
  "reference_fixtures": ["fixtures/reference-01.json","fixtures/synthetic-target.json"]
}
