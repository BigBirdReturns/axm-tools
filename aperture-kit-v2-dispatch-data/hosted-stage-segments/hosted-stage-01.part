        for name in ("dispatch-verification.json", "blocked-progress.json", "qualification.json", "qualification.env", "node-version.txt", "source-inventory.sha256"):
            shutil.copy2(root / name, out / label / name)
        shutil.copytree(root / "logs", out / label / "logs")
    shutil.copytree(args.os_receipts.resolve(), out / "os-receipts", dirs_exist_ok=True)
    receipt = {
